<Window x:Class="Faktformer_0._0._1.Email1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        mc:Ignorable="d"
        Title="Ustawienia e-mail" Height="330" Width="400" Background="#FF2A284F" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="230"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="15,20,15,0">
            <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Serwer SMTP" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                <TextBox Name="TextBoxSMTPEmail1" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
            </Grid>
            <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Port" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <TextBox Name="TextBoxPortEmail1" HorizontalAlignment="Right" Width="68" Margin="0, 0, 2, 0"/>
                    <ComboBox Name="ComboBoxPortEamil1" HorizontalAlignment="Right" Width="168" Margin="2, 0, 0 0" SelectedIndex="0">
                        <ComboBoxItem/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Użytkownik" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                <TextBox Name="TextBoxUserEmail1" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
            </Grid>
            <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Hasło" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                <PasswordBox Name="PasswordBoxPasswordEmail1" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
            </Grid>
            <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content='pole "Od"' HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                <TextBox Name="TextBoxOdEmail1" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
            </Grid>
            <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Email do raportów" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                <TextBox Name="TextBoxRaportEmail1" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,15,0,20" HorizontalAlignment="Center" Height="25" VerticalAlignment="Top">
            <Button Content="Zapisz" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonZapisz_Click"/>
            <Button Content="Wyślij email testowy" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="120" Background="#FF6961F5" Foreground="White" Click="ButtonWyślijMaila_Click"/>
            <Button Content="Anuluj" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
