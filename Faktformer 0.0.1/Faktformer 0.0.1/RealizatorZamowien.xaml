<Window x:Class="Faktformer_0._0._1.RealizatorZamowien"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        xmlns:wpfTool="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit" 
        mc:Ignorable="d"
        Title="Nowe zadanie - realizacj zamowień" Height="620" Width="800" Background="#FF2A284F" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="15,10,15,20" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 15, 20, 0">
                <Label Content="Nazwa" Margin="8, 0 ,8, 0" Foreground="White"/>
                <TextBox Width="240" Name="TextBoxNazwa" Height="20" Margin="8, 0 ,8, 0"/>
                <Label Content="Magazyn" Margin="8, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxMagazyn" Width="110" SelectedIndex="0" Margin="8, 0 ,8, 0">
                    <!--To będzie wymienione dynamicznym kodem-->
                    <ComboBoxItem Content="Wszystkie"/>
                    <ComboBoxItem Content="Główny"/>
                </ComboBox>
                <Label Content="Rodzaj" Margin="8, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxRodzajFaktura" Width="110" SelectedIndex="0" Margin="8, 0 ,8, 0">
                    <!--Rodzaje faktury-->
                    <ComboBoxItem Content=""/>

                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 15, 20, 0">
                <CheckBox Name="CheckBoxZadanieAktywne" VerticalAlignment="Center" Content="Zadanie aktywne" Margin="8, 0 ,8, 0" Foreground="White"/>
                <Label Content="Waluta" Margin="8, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxWaluta" Width="50" SelectedIndex="0" Margin="8, 0 ,11, 0">
                    <!--Rodzaje waluty-->
                    <ComboBoxItem Content=""/>
                </ComboBox>
                <Label Content="Płatność" Margin="8, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxPlatnosc" Width="110" SelectedIndex="0" Margin="8, 0 ,8, 0">
                    <!--Rodzaje Płatnośći-->
                    <ComboBoxItem Content=""/>
                </ComboBox>
                <Label Content="Termin" Margin="8, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxTermin" Width="110" SelectedIndex="0" Margin="8, 0 ,8, 0">
                    <!--Terminy-->
                    <ComboBoxItem Content=""/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 15, 20, 0">
                <Label Content="Status" Margin="8, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxStatus" Width="110" SelectedIndex="0" Margin="8, 0 ,8, 0">
                    <!--Statusy-->
                    <ComboBoxItem Content=""/>
                </ComboBox>
                <Label Content="Kategoria" Margin="0, 0 ,8, 0" Foreground="White"/>
                <ComboBox Height="20" Name="ComboBoxKategoria" Width="110" SelectedIndex="0" Margin="1, 0 ,8, 0">
                    <!--Kategorie-->
                    <ComboBoxItem Content=""/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Margin="15,0,15,0" Grid.Row="1" Orientation="Horizontal">
            <Button Content="Parametry" Padding="2, 0, 2, 0" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White"/>
        </StackPanel>
        <StackPanel Margin="15,11,15,0" Grid.Row="2">
            <GroupBox Height="100" Header="Częstotliwość" Margin="8" BorderBrush="White" Foreground="White" Background="#FF153D8E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Label Content="Wstawiaj co" Margin="4, 2, 0, 0" Foreground="White"/>
                        <wpfTool:DoubleUpDown Name="NumBoxOkres" Height="24" VerticalAlignment="Top" Margin="0, 4, 0, 0" ParsingNumberStyle="Integer" DefaultValue="1" Value="1" Text="1" Minimum="1"/>
                        <ComboBox Height="24" Name="ComboBoxOkres" Width="60" SelectedIndex="0" VerticalAlignment="Top" Margin="4, 4, 0, 0">
                            <!--Okresy czasu-->
                            <ComboBoxItem Content="dni"/>
                            <ComboBoxItem Content="tygodni"/>
                            <ComboBoxItem Content="miesięcy"/>
                        </ComboBox>
                        <Label Content="Począwszy od" Margin="4, 2, 0, 0" Foreground="White"/>
                        <DatePicker Name="DatePickerOd" Height="24" VerticalAlignment="Top" Margin="4, 4, 0, 0" Background="White"/>
                        <Label Content="do" Margin="4, 2, 0, 0" Foreground="White"/>
                        <Border BorderThickness="1" BorderBrush="Gray" Height="24" VerticalAlignment="Top" Margin="4, 4, 0, 0">
                            <Grid Background="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Name="CheckBoxDate" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="CheckBoxDate_Click"/>
                                <DatePicker Name="DatePickerDo" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" IsEnabled="False" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <CheckBox Name="CheckBoxDateMonth" Grid.Row="1" Content="Wyrównaj do ostatniego dnia miesiąca" VerticalAlignment="Center" Margin="280, 0, 0, 0" Foreground="White"/>
                </Grid>
            </GroupBox>
            <GroupBox Height="110" Header="Realizuj zamówienia spełniające kryteria" Margin="8" BorderBrush="White" Foreground="White" Background="#FF153D8E">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="10, 2, 10, 0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Grupa (kontrahent)" Margin="3, 2 ,3, 2" Foreground="White"/>
                            <ComboBox Name="ComboBoxGrupaKontrahent" Height="20" Width="110" SelectedIndex="0" Margin="3, 2 ,3, 2">
                                <ComboBoxItem/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Cecha (kontrahent)" Margin="3, 2 ,3, 2" Foreground="White"/>
                            <ComboBox Name="ComboBoxCechaKontrahent" Height="20" Width="110" SelectedIndex="0" Margin="3, 2 ,3, 2">
                                <ComboBoxItem/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Name="CheckBoxZaplacone" Content="Zapłacone" Foreground="White"  Margin="120, 2 ,3, 2"/>
                    </StackPanel>
                    <StackPanel Margin="3, 2, 3, 0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Falga własna" Margin="3, 2, 3, 2" Foreground="White"/>
                            <ComboBox Name="ComboBoxFlagaWlasna" Height="20" Width="110" SelectedIndex="0" Margin="3, 2 ,3, 2">
                                <ComboBoxItem/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Opis zawiera" Margin="3, 2 ,3, 2" Foreground="White"/>
                            <TextBox Name="TextBoxOpisZawiera" Height="20" Width="110" Margin="3, 2 ,3, 2"/>
                        </StackPanel>
                        <CheckBox Name="CheckBoxMinalTermin" Content="Minął termin realizacji" Foreground="White"  Margin="85, 2 ,3, 2"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="20, 2, 0, 2" Height="20">
                <CheckBox Name="CheckBoxZapiszWydruki" Content="Zapisz wydruki PDF utworzonych dokumentów" Height="24" Foreground="White" Click="CheckBoxZapiszWydruki_Click"/>
                <TextBox Name="TextBoxFile" Width="150" Margin="4, 0, 4 ,0" TextChanged="TextBoxFile_TextChanged" IsEnabled="False"/>
                <Button Name="ButtonFile" Content="Przeglądaj" Margin="4, 0, 4 ,0" IsEnabled="False" Click="ButtonSelectFile_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="20, 2, 20, 0">
                <Label Content="Opis (uwagi)"  Margin="0, 0, 20, 0" Foreground="White"/>
                <TextBox Name="TextBoxOpis" Width="610" Margin="4, 2, 4 ,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="20, 0, 20, 0">
                <TextBlock  Margin="100, 0, 0, 0" FontSize="11" Text="Możesz w tym polu zastosować etykiety {tydzień}, {miesiąc}, {poprzednimiesiąc}, {rok}, które przy wstawianiu zostaną zastąione automatycznie odpowiednią dla aktualnej daty liczbą" TextWrapping="Wrap" Width="610" Foreground="White" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Height="30" HorizontalAlignment="Center" Margin="0,4,0,0" VerticalAlignment="Top" Width="220">
            <Button Content="Zapisz" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonZapisz_Click"/>
            <Button Content="Anuluj" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
