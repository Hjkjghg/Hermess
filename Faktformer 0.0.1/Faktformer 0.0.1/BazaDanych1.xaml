<Window x:Class="Faktformer_0._0._1.BazaDanych1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        mc:Ignorable="d"
        Title="BazaDanych1" Height="350" Width="400" Background="#FF2A284F" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="280"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="15,20,15,0">
            <GroupBox Header="Baza danych" Background="#FF153D8E" Foreground="White">
                <StackPanel>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Serwer" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                        <TextBox Name="TextBoxSerwer" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
                    </Grid>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Użytkownik" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                        <TextBox Name="TextBoxUser" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
                    </Grid>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Hasło" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                        <PasswordBox Name="PasswordBoxBaza" HorizontalAlignment="Right" Grid.Column="1" Width="240"/>
                    </Grid>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Podmiot" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                        <ComboBox Name="ComboBoxPodmiot" HorizontalAlignment="Right" Grid.Column="1" Width="240" SelectedIndex="0">
                            <ComboBoxItem/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Ustawienia subiekta GT" Background="#FF153D8E" Foreground="White">
                <StackPanel>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Użytkownik" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                        <ComboBox Name="ComboBoxUser" HorizontalAlignment="Right" Grid.Column="1" Width="240" SelectedIndex="0">
                            <ComboBoxItem/>
                        </ComboBox>
                    </Grid>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 4, 2, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Hasło" HorizontalAlignment="Left" Grid.Column="0" Foreground="White"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <PasswordBox Name="PasswordBoxSubiekt" HorizontalAlignment="Right"  Width="118" Margin="0, 0, 2, 0"/>
                            <Button Content="Sprawdź połączenie" Width="118" Margin="2, 0, 0, 0"/>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button Content="Zapisz" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonZapisz_Click"/>
            <Button Content="Anuluj" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
