                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="ExampleBorder1" HorizontalAlignment="Stretch" VerticalAlignment="Top"  BorderBrush="#2A284F" BorderThickness="2" Height="20">
