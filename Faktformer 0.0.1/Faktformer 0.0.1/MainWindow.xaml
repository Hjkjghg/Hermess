<Window x:Name="mWindow" x:Class="Faktformer_0._0._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        mc:Ignorable="d"
        MinHeight="400"
        MinWidth="855"
        Title="Faktformer" Height="450" Width="900">

    <Grid Background="#2A284F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="21"/>
            <RowDefinition MaxHeight="170"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <local:MenuMain Grid.Row="0"/>
        <Grid Grid.Row="1" Background="#FF2A284F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="19*"/>
                <RowDefinition MinHeight="100" Height="85*"/>
            </Grid.RowDefinitions>
            <Image HorizontalAlignment="Left" Height="80" VerticalAlignment="Top" Width="200" Grid.Column="1" Grid.Row="1" Source="/logo-rabiks-biale.png"/>
            <Label Grid.Column="1" Content="Faktformer" FontSize="18" HorizontalAlignment="Left" Margin="200,30,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>
            <Label Grid.Column="1" Content="Zautomatyzowane wystawianie faktur" HorizontalAlignment="Left" Margin="200,60,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>

        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="28"/>
                <RowDefinition/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="15, 0, 15, 0" Orientation="Horizontal">
                
                <Button Width="80" Height="30" VerticalAlignment="Bottom" Content="Zadania" Background="#6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonTabZadania_Click"/>
                <Button Width="80" Height="30" VerticalAlignment="Bottom" Content="Historia" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonTabHistoria_Click"/>
                <Button Width="80" Height="30" VerticalAlignment="Bottom" Content="Log" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonTabLog_Click"/>



            </StackPanel>
            <Grid Margin="15, 0, 15, 0" Grid.Row="1" Background="#A7CDFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="187*"/>
                    <ColumnDefinition Width="159*"/>
                    <ColumnDefinition Width="208*"/>
                    <ColumnDefinition Width="316"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Magazyn" Margin="10,0,0,0" HorizontalAlignment="Left" Width="58" Foreground="Black"/>
                <ComboBox Grid.Column="0" Name="ComboBoxMagazyn" Width="90" HorizontalAlignment="Left" Margin="75,4,0,4" SelectedIndex="0">
                    <!--To będzie wymienione dynamicznym kodem-->
                    <ComboBoxItem Content="Wszystkie"/>
                    <ComboBoxItem Content="Główny"/>
                </ComboBox>
                <Label Grid.Column="1" Content="Typ" Margin="10,0,0,0" HorizontalAlignment="Left" Width="28" Foreground="Black"/>
                <ComboBox Grid.Column="1" Name="ComboBoxTyp" Width="90" HorizontalAlignment="Left" Margin="45,4,0,4">
                    <!--To będzie wymienione dynamicznym kodem-->
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                </ComboBox>
                <Label Grid.Column="2" Content="Częstotiwość" Margin="10,0,0,0" HorizontalAlignment="Left" Width="79" Foreground="Black"/>
                <ComboBox Grid.Column="2" Name="ComboBoxFreq" Width="90" HorizontalAlignment="Left" Margin="95,4,0,4">
                    <!--To będzie wymienione dynamicznym kodem-->
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                </ComboBox>
                <Label Grid.Column="3" Content="Nazwa" Margin="10,0,0,0" HorizontalAlignment="Left" Width="45" Foreground="Black"/>
                <TextBox Name="TextBoxName" Grid.Column="3" Margin="60,0,0,0" HorizontalAlignment="Left" Height="20" VerticalAlignment="Center" Width="160"/>
                <Button Content="Filtruj" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="230,0,0,0" Width="70" Height="20"/>

            </Grid>

            <Grid Grid.Row="2" VerticalAlignment="Stretch" Margin="15, 0, 15, 0" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="ExampleBorder" HorizontalAlignment="Stretch" VerticalAlignment="Top"  BorderBrush="#2A284F" BorderThickness="2" Height="20">
                    <Grid x:Name="ExampleTable" Grid.Row="0" Height="20" VerticalAlignment="Center" HorizontalAlignment="Stretch"  Grid.RowSpan="1" ShowGridLines="True">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="247*"/>
                            <ColumnDefinition Width="145*"/>
                            <ColumnDefinition Width="75*"/>
                            <ColumnDefinition Width="105*"/>
                            <ColumnDefinition Width="182*"/>
                            <ColumnDefinition Width="83*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <CheckBox Name="MainCheckBox" Click="CheckboxCheckedAll" Grid.Column="0" Margin="5,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="16" Width="16"/>
                        <TextBlock Name="ExampleTextBlock" Grid.Column="1" Margin="10,0,10,2" Text="Nazwa zadania" VerticalAlignment="Center" Height="16" Foreground="#2A284F"/>
                        <TextBlock Grid.Column="2" Margin="10,0,10,2" Text="Częstotliwość" VerticalAlignment="Center" Height="16" Foreground="#2A284F"/>
                        <TextBlock Grid.Column="6" Margin="10,0,10,2" Text="Status" VerticalAlignment="Center" Height="16" Foreground="#2A284F"/>
                        <TextBlock Grid.Column="5" Margin="10,0,10,2" Text="Następne wystawienie" VerticalAlignment="Center" Height="16" Foreground="#2A284F"/>
                        <TextBlock Grid.Column="4" Margin="10,0,10,2" Text="Magazyn" VerticalAlignment="Center" Height="16" Foreground="#2A284F"/>
                        <TextBlock Grid.Column="3" Margin="10,0,10,2" Text="Typ" VerticalAlignment="Center" Height="16" Foreground="#2A284F"/>

                    </Grid>
                </Border>
                <Grid Grid.Row="1" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="281*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
                        <StackPanel Name="TabPanel" MinHeight="20" VerticalAlignment="Stretch" Loaded="TableMain_Loaded">

                            <!--Tu wrzucane są elemnty tabei w strukturze grid(kontrolka), dane podane z kodu(pobrane z bazy danych/systemu pilków)-->

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="393*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15, 0, 0, 0">
                    <Button Content="Nowe zadanie czykliczne" HorizontalAlignment="Left" Padding="4" Margin="0, 10, 0, 10" Click="ButtonNoweZadanie_Click" Background="#FF6961F5" Foreground="White"/>
                    <Button Content="Uruchom zadania" HorizontalAlignment="Left" Padding="4" Margin="20, 10, 0, 10" Background="#FF6961F5" Foreground="White"/>
                    <Button HorizontalAlignment="Left" Padding="4" Margin="20, 10, 0, 10" Click="ButtonRefresh_Click" Background="#FF6961F5" Foreground="White">
                        <Image Height="15" Width="15"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Zreailzuj zamówienia" HorizontalAlignment="Right" Padding="4" Margin="10, 10, 10, 10" Background="#FF6961F5" Foreground="White" Click="ButtonRealizojZamowienie_Click"/>
                    <Button Content="Powiel dokumenty" HorizontalAlignment="Right" Padding="4" Margin="10, 10, 10, 10" Background="#FF6961F5" Foreground="White" Click="ButtonPowielDokumenty_Click"/>
                    <Button Content="Faktura seryjna jednorazowa" HorizontalAlignment="Right" Padding="4" Margin="10, 10, 10, 10" Background="#FF6961F5" Foreground="White"/>
                </StackPanel>
                <TextBlock Name="TableNumerer"  Grid.Column="2" Text="*/*" FontSize="30" HorizontalAlignment="Center" Foreground="White"/>
            </Grid>

        </Grid>

    </Grid>
</Window>
