        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        mc:Ignorable="d"
        MinHeight="400"
        MinWidth="855"
        Title="Hermess" Height="450" Width="900">

    <Grid Background="#2A284F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="21"/>
            <RowDefinition MaxHeight="170" Height="170*"/>
            <RowDefinition Height="40
                           "/>
            <RowDefinition Height="227*"/>
        </Grid.RowDefinitions>

        <local:MenuMain Grid.Row="0"/>
        <Grid Grid.Row="1" Background="#FF2A284F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="19*"/>
                <RowDefinition MinHeight="100" Height="85*"/>
            </Grid.RowDefinitions>
            <Image HorizontalAlignment="Left" Height="80" VerticalAlignment="Top" Width="200" Grid.Column="1" Grid.Row="1" Source="/logo-rabiks-biale.png"/>
            <Label Grid.Column="1" Content="Hermess" FontSize="18" HorizontalAlignment="Left" Margin="200,30,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>
            <Label Grid.Column="1" Content="Zautomatyzowane wystawianie faktur" HorizontalAlignment="Left" Margin="200,60,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>

        </Grid>
        <StackPanel Grid.Row="2" Margin="15, 0, 15, 0" Orientation="Horizontal">

            <Button Width="80" Height="30" VerticalAlignment="Bottom" Content="Zadania" Background="#6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonTabZadania_Click"/>
            <Button Width="80" Height="30" VerticalAlignment="Bottom" Content="Historia" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonTabHistoria_Click"/>
            <Button Width="80" Height="30" VerticalAlignment="Bottom" Content="Log" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonTabLog_Click"/>



        </StackPanel>
