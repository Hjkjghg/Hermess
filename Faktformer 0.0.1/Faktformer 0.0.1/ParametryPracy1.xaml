<Window x:Class="Faktformer_0._0._1.ParametryPracy1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        mc:Ignorable="d"
        Title="Parametry pracy" Height="315" Width="500" Background="#FF2A284F" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="235"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="15,20,15,0" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 5">
                <CheckBox Name="CheckBoxProces" VerticalAlignment="Center" Margin="0, 0, 5, 0"/>
                <TextBlock Text="Przetwarzaj pominięte zadania nawet, jeśli ich wywołanie nastąpiło po wyznaczonym terminie dokumentów" Foreground="White" TextWrapping="Wrap" Width="450"/>
            </StackPanel>
            <CheckBox Name="CheckBoxZalogowanie" Content="Wymagaj zalogowania za pomocą użytkownika Subiekta GT przy załadowaniu profilu" Margin="0, 5, 0, 5" Background="White" Foreground="White"/>
            <TextBlock Text="Zaznaczenie powyższej opcji spowoduje, że dokumenty generowane ręcznie będą wystawione przez zalogowanego urzytkownika." Foreground="White" TextWrapping="Wrap" Margin="5, 2, 0, 4"/>
            <TextBlock Text="Do wystawienia dokumentów automatycznie wg. hamonogramu nadal konieczne jest wprowadzenie ustawień powyżej" Foreground="White" TextWrapping="Wrap" Margin="5, 4, 0, 5"/>
            <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                <Label Content="Przeliczaj według" Foreground="White" Margin="0, 0, 10, 0"/>
                <ComboBox Name="ComboBoxCena" Width="350">
                    <ComboBoxItem/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Zmiana rodzaju cen wymaga ręcznej aktuaizacji cen wszystkich zadań tworzenia faktur seryjnych utworzonych w profilu." Foreground="White" TextWrapping="Wrap" Margin="5, 2, 0, 4"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Height="25" Margin="0,15,0,0" Width="220">
            <Button Content="Zapisz" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonZapisz_Click"/>
            <Button Content="Anuluj" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
