<Window x:Class="Faktformer_0._0._1.PowielaczDokumentow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Faktformer_0._0._1"
        xmlns:wpfTool="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit" 
        mc:Ignorable="d"
        Title="Nowe zadanie - powielacz" Height="440" Width="770" Background="#FF2A284F" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="121*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="25, 20, 15, 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <Label Content="Nazwa" Margin="4, 0, 4, 0" Foreground="White"/>
                    <TextBox Name="TextBoxNazwa" Width="200" Margin="4, 0, 4, 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <Label Content="Magazyn" Foreground="White"/>
                    <ComboBox Name="ComboBoxMagazyn" Width="150" Margin="4, 0, 4, 0">
                        <ComboBoxItem/>
                    </ComboBox>
                    <Label Content="Rodzaj" Margin="4, 0, 4, 0" Foreground="White"/>
                    <ComboBox Name="ComboBoxRodzaj" Width="150" Margin="4, 0, 4, 0">
                        <ComboBoxItem/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal">
               
                
            </StackPanel>
            <CheckBox Name="CheckBoxZadanieAktywne" Margin="54, 15, 0, 0" Content="Zadanie aktywne" Foreground="White"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="15,0,15,0" Grid.Row="1">
            <Button Content="Parametry" Padding="2, 0, 2, 0" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonParametry_Click"/>
            <Button Content="Dokumenty" Padding="2, 0, 2, 0" Background="#FF6961F5" BorderBrush="#FF6961F5" Foreground="White" Click="ButtonDokumenty_Click"/>
        </StackPanel>
        <Grid Name="Parametry" Grid.Row="1" Margin="0,20,0,0" Grid.RowSpan="2">
            <StackPanel Margin="15, 0, 15, 0">
                <GroupBox Height="100" Header="Częstotliwość" Margin="8" BorderBrush="White" Foreground="White" Background="#FF153D8E">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                            <Label Content="Wstawiaj co" Margin="4, 2, 0, 0" Foreground="White"/>
                            <wpfTool:DoubleUpDown Name="NumBoxOkres" Height="24" VerticalAlignment="Top" Margin="0, 4, 0, 0" ParsingNumberStyle="Integer" DefaultValue="1" Value="1" Text="1"/>
                            <ComboBox Height="24" Name="ComboBoxOkres" Width="60" SelectedIndex="0" VerticalAlignment="Top" Margin="4, 4, 0, 0">
                                <!--Okresy czasu-->
                                <ComboBoxItem Content="dni"/>
                                <ComboBoxItem Content="tygodni"/>
                                <ComboBoxItem Content="miesięcy"/>
                            </ComboBox>
                            <Label Content="Począwszy od" Margin="4, 2, 0, 0" Foreground="White"/>
                            <DatePicker Name="DatePickerOd" Height="24" VerticalAlignment="Top" Margin="4, 4, 0, 0" Background="White"/>
                            <Label Content="do" Margin="4, 2, 0, 0" Foreground="White"/>
                            <Border BorderThickness="1" BorderBrush="Gray" Height="24" VerticalAlignment="Top" Margin="4, 4, 0, 0">
                                <Grid Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="CheckBoxDate" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="CheckBoxDate_Click" />
                                    <DatePicker Name="DatePickerDo" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" IsEnabled="False" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <CheckBox Name="CheckBoxDateMonth" Grid.Row="1" Content="Wyrównaj do ostatniego dnia miesiąca" VerticalAlignment="Center" Margin="280, 0, 0, 0" Foreground="White"/>
                    </Grid>
                </GroupBox>
                <CheckBox Margin="20, 2, 0, 2" Name="CheckBoxPrzypadek" Content="W przypadku niepowodzenia(np. braku towaru, przekroczonym imicie kredytwym) ponawiaj do skutku przy kolejnych wywołaniach." Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="20, 2, 0, 2" Height="20">
                    <CheckBox Name="CheckBoxZapiszWydruki" Content="Zapisz wydruki PDF utworzonych dokumentów" Height="24" Foreground="White" Click="CheckBoxZapiszWydruki_Click"/>
                    <TextBox Name="TextBoxFile" Width="150" Margin="4, 0, 4 ,0" TextChanged="TextBoxFile_TextChanged" IsEnabled="False"/>
                    <Button Name="ButtonFile" Content="Przeglądaj" Margin="4, 0, 4 ,0" IsEnabled="False" Click="ButtonSelectFile_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20, 2, 20, 0">
                    <Label Content="Opis (uwagi)"  Margin="0, 0, 20, 0" Foreground="White"/>
                    <TextBox Name="TextBoxOpis" Width="610" Margin="4, 2, 4 ,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20, 0, 20, 0">
                    <TextBlock  Margin="100, 0, 0, 0" FontSize="11" Text="Możesz w tym polu zastosować etykiety {tydzień}, {miesiąc}, {poprzednimiesiąc}, {rok}, które przy wstawianiu zostaną zastąione automatycznie odpowiednią dla aktualnej daty liczbą" TextWrapping="Wrap" Width="610" Foreground="White" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>

        </Grid>
        <Grid Panel.ZIndex="-1" Name="Dokumenty" Grid.Row="2" IsEnabled="False">
            
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Height="30" HorizontalAlignment="Center" Margin="0,4,0,0" VerticalAlignment="Top" Width="220">
            <Button Content="Zapisz" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonZapisz_Click"/>
            <Button Content="Anuluj" HorizontalAlignment="Center" Margin="10, 0, 10, 0" Width="90" Background="#FF6961F5" Foreground="White" Click="ButtonAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
